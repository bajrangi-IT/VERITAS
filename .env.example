# ==============================================================================
# VERITAS AI Environment Configuration
# All API keys are kept strictly server-side and never exposed to the client.
# ==============================================================================

# Server Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Security & CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=60
MAX_CONCURRENT_RESEARCH_TASKS=4
MAX_SEARCH_RESULTS=10
SEARCH_TIMEOUT_SECONDS=15

# Search Providers (Optional: system gracefully falls back to authentic built-in engine if unset)
TAVILY_API_KEY=
SEARCH_PROVIDER=hybrid  # options: hybrid, tavily, direct, mock

# LLM Providers (Optional: system provides deterministic heuristic verification and supports Gemini/OpenAI API keys)
GEMINI_API_KEY=
OPENAI_API_KEY=
DEFAULT_MODEL=gemini-1.5-flash

# SSRF Protection
ALLOW_PRIVATE_IPS=false
HTTP_MAX_REDIRECTS=3
HTTP_MAX_RESPONSE_BYTES=1048576  # 1MB limit per external page fetch
